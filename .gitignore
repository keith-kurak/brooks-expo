# The App Clip's icon set, which prebuild draws from assets/icon.png
/targets/*/Assets.xcassets/

# Argent screen recordings — writing these into the project root retriggers
# Metro's file watcher and reloads the running app mid-QA.
.argent/

# eas-simulator-evidence screenshots, verdicts, and built sites (tools/agent)
/evidence/
