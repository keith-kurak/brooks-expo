{
  "expo": {
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/5db41437-f382-47ea-90be-998a34a3336f"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "appStoreUrl": "https://apps.apple.com/app/id6804744941",
      "supportsTablet": true,
      "icon": "./assets/app.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      "expo-sqlite",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.keithkurak.ecommercedemo.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.keithkurak.ecommercedemo"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.keithkurak.ecommercedemo.clip",
                  "targetName": "clip",
                  "entitlements": {
                    "com.apple.developer.associated-domains": [
                      "appclips:ecommerce-demo.expo.app"
                    ],
                    "com.apple.security.application-groups": [
                      "group.com.keithkurak.ecommercedemo"
                    ],
                    "com.apple.developer.parent-application-identifiers": [
                      "$(AppIdentifierPrefix)com.keithkurak.ecommercedemo"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "5db41437-f382-47ea-90be-998a34a3336f"
      }
    },
    "owner": "keithco"
  }
}
